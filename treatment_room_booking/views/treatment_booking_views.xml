<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_treatment_booking_list" model="ir.ui.view"><field name="name">treatment.booking.list</field><field name="model">treatment.booking</field><field name="arch" type="xml"><list decoration-muted="state == 'cancelled'"><field name="name"/><field name="start_datetime"/><field name="end_datetime"/><field name="room_id"/><field name="customer_id" string="Patient"/><field name="service_id"/><field name="therapist_ids" widget="many2many_tags" domain="[('is_therapist', '=', True)]"/><field name="payment_status"/><field name="state"/></list></field></record>
  <record id="view_treatment_booking_form" model="ir.ui.view"><field name="name">treatment.booking.form</field><field name="model">treatment.booking</field><field name="arch" type="xml"><form><header>
    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
    <button name="action_open_payment" type="object" string="Receipt Payment" class="btn-primary" invisible="state not in ['confirmed', 'done'] or payment_status == 'paid'"/>
    <button name="action_start" type="object" string="Start Treatment" invisible="state != 'confirmed'"/>
    <button name="action_mark_done" type="object" string="Mark as Done" class="btn-primary" invisible="state not in ['confirmed', 'in_progress']"/>
    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,done,cancelled"/>
  </header><sheet>
    <div class="oe_button_box" name="button_box">
      <button name="action_print_receipt" type="object" class="oe_stat_button" icon="fa-print" string="Print Receipt" invisible="payment_status != 'paid'"/><button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-credit-card" invisible="payment_count == 0"><field name="payment_count" widget="statinfo" string="Payments"/></button>
      <button name="action_view_inventory" type="object" class="oe_stat_button" icon="fa-truck" invisible="inventory_count == 0"><field name="inventory_count" widget="statinfo" string="Inventory"/></button>
    </div>
    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group><field name="customer_id" string="Patient" domain="[('is_patient', '=', True)]" context="{'default_is_patient': True}" readonly="state != 'draft'"/><field name="contact_number"/><field name="room_id" readonly="state != 'draft'"/><field name="service_ids" widget="many2many_tags" readonly="state != 'draft'"/></group><group><field name="therapist_ids" widget="many2many_tags" domain="[('is_therapist', '=', True)]" context="{'default_is_therapist': True}" readonly="state != 'draft'"/><field name="start_datetime" readonly="state != 'draft'"/><field name="end_datetime"/><field name="cleaning_minutes"/><field name="amount_total" readonly="1"/><field name="discount_percent" readonly="state in ['done', 'cancelled'] or payment_status != 'unpaid'"/><field name="discounted_price" readonly="1"/><field name="paid_amount" readonly="1"/><field name="balance_amount" readonly="1"/><field name="payment_status" readonly="1"/></group></group><group><field name="notes"/></group></sheet></form></field></record>
  <record id="view_treatment_booking_payment_form" model="ir.ui.view"><field name="name">treatment.booking.payment.form</field><field name="model">treatment.booking.payment</field><field name="arch" type="xml"><form string="Receipt Payment"><sheet><group><group><field name="booking_id" invisible="1"/><field name="customer_id" string="Patient" readonly="1"/><field name="mobile_number" readonly="1"/><field name="date" readonly="1"/><field name="journal_id" domain="[('type', 'in', ['cash', 'bank'])]"/></group><group><field name="total_amount" readonly="1"/><field name="discount_percent"/><field name="discounted_price" readonly="1"/><field name="paid_amount"/><field name="remaining_amount" readonly="1"/><field name="payment_action" widget="radio"/></group></group><footer><button string="Register Payment" type="object" name="action_register_payment" class="btn-primary"/><button string="Discard" special="cancel" class="btn-secondary"/></footer></sheet></form></field></record>
  <record id="action_treatment_bookings" model="ir.actions.act_window"><field name="name">Treatment Bookings</field><field name="res_model">treatment.booking</field><field name="view_mode">list,form</field></record>
</odoo>
