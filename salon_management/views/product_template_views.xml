<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_salon_management" model="ir.ui.view">
        <field name="name">product.template.form.inherit.salon.management</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="time_taken" widget="float_time" invisible="type != 'service'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Equipments" name="equipments" invisible="type != 'service'">
                    <field name="equipment_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="price"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
