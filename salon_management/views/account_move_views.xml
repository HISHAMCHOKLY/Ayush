<odoo>
    <record id="view_move_form_salon" model="ir.ui.view">
        <field name="name">account.move.form.salon</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="salon_order_id" readonly="1" invisible="not salon_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
