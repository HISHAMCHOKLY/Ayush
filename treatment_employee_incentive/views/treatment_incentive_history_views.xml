<odoo>
    <record id="view_treatment_incentive_history_list" model="ir.ui.view">
        <field name="name">treatment.incentive.history.list</field>
        <field name="model">treatment.incentive.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="target_achieved">
                <field name="treatment_date"/>
                <field name="company_id"/>
                <field name="employee_id"/>
                <field name="booking_id"/>
                <field name="customer_id"/>
                <field name="service_id"/>
                <field name="booking_type"/>
                <field name="paid_amount_basis"/>
                <field name="therapist_count"/>
                <field name="treatment_amount" sum="Paid Amount per Therapist"/>
                <field name="incentive_percentage"/>
                <field name="percentage_incentive_amount" sum="Percentage Incentive"/>
                <field name="target_bonus_amount" sum="Target Bonus"/>
                <field name="incentive_amount" sum="Total Incentive"/>
                <field name="period_key"/>
                <field name="target_cycle"/>
                <field name="cycle_paid_amount" string="Accumulated Incentive in Cycle"/>
                <field name="target_amount" string="Monthly Incentive Target"/>
                <field name="target_progress"/>
                <field name="target_achieved"/>
            </list>
        </field>
    </record>

    <record id="view_treatment_incentive_history_form" model="ir.ui.view">
        <field name="name">treatment.incentive.history.form</field>
        <field name="model">treatment.incentive.history</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_booking" type="object" string="Open Booking" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="employee_id"/>
                            <field name="booking_id"/>
                            <field name="customer_id"/>
                            <field name="service_id"/>
                            <field name="booking_type"/>
                            <field name="plan_purchase_id" invisible="not plan_purchase_id"/>
                            <field name="treatment_date"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="paid_amount_basis"/>
                            <field name="therapist_count"/>
                            <field name="treatment_amount"/>
                            <field name="incentive_percentage"/>
                            <field name="percentage_incentive_amount"/>
                            <field name="target_bonus_amount"/>
                            <field name="incentive_amount"/>
                            <field name="period_key"/>
                            <field name="year"/>
                            <field name="target_amount" string="Monthly Incentive Target"/>
                            <field name="target_cycle"/>
                            <field name="cycle_paid_amount" string="Accumulated Incentive in Cycle"/>
                            <field name="target_progress"/>
                            <field name="target_achieved"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_treatment_incentive_history_pivot" model="ir.ui.view">
        <field name="name">treatment.incentive.history.pivot</field>
        <field name="model">treatment.incentive.history</field>
        <field name="arch" type="xml">
            <pivot string="Employee Incentive Performance">
                <field name="company_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="year" type="col"/>
                <field name="treatment_amount" type="measure"/>
                <field name="incentive_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_treatment_incentive_history_graph" model="ir.ui.view">
        <field name="name">treatment.incentive.history.graph</field>
        <field name="model">treatment.incentive.history</field>
        <field name="arch" type="xml">
            <graph string="Incentive by Employee and Year" type="bar">
                <field name="employee_id"/>
                <field name="year" interval="year"/>
                <field name="incentive_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_treatment_incentive_history" model="ir.actions.act_window">
        <field name="name">Treatment Incentive History</field>
        <field name="res_model">treatment.incentive.history</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_group_by_year': 1}</field>
    </record>

    <record id="view_treatment_incentive_history_search" model="ir.ui.view">
        <field name="name">treatment.incentive.history.search</field>
        <field name="model">treatment.incentive.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="booking_id"/>
                <field name="customer_id"/>
                <field name="service_id"/>
                <field name="period_key"/>
                <field name="year"/>
                <filter name="target_achieved" string="Target Achieved" domain="[('target_achieved','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_employee" string="Employee" context="{'group_by':'employee_id'}"/>
                    <filter name="group_by_period" string="Month" context="{'group_by':'period_key'}"/>
                    <filter name="group_by_year" string="Year" context="{'group_by':'year'}"/>
                    <filter name="group_by_service" string="Service" context="{'group_by':'service_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_treatment_incentive_root" name="Treatment Incentives" sequence="95"/>
    <menuitem id="menu_treatment_incentive_history" name="Treatment Incentive History"
              parent="menu_treatment_incentive_root" action="action_treatment_incentive_history" sequence="10"/>
</odoo>
