<odoo>
    <record id="view_treatment_plan_list" model="ir.ui.view">
        <field name="name">treatment.plan.list</field>
        <field name="model">treatment.plan</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="pack_type"/><field name="treatment_type"/><field name="price"/><field name="validity_months"/><field name="total_sessions"/><field name="per_session_price"/><field name="active"/></list>
        </field>
    </record>
    <record id="view_treatment_plan_form" model="ir.ui.view">
        <field name="name">treatment.plan.form</field><field name="model">treatment.plan</field>
        <field name="arch" type="xml">
            <form><sheet>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="active"/><field name="pack_type"/><field name="member_limit" readonly="1"/><field name="treatment_type"/></group>
                <group><field name="currency_id" invisible="1"/><field name="price"/><field name="validity_months"/><field name="total_sessions" readonly="1"/><field name="per_session_price" readonly="1"/></group></group>
                <notebook><page string="Included Services"><field name="line_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="service_id"/><field name="quantity"/><field name="unit_price" readonly="1"/></list></field></page></notebook>
            </sheet></form>
        </field>
    </record>
    <record id="action_treatment_plans" model="ir.actions.act_window">
        <field name="name">Treatment Plans</field><field name="res_model">treatment.plan</field><field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_treatment_plan_root" name="Treatment Plans" parent="treatment_room_booking.menu_treatment_root" sequence="30" />
    <menuitem id="menu_treatment_plans" name="Plan Configuration" parent="menu_treatment_plan_root" action="action_treatment_plans" sequence="10"/>
</odoo>
