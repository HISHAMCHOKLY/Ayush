<odoo noupdate="1">
    <record id="ir_cron_expire_treatment_plans" model="ir.cron">
        <field name="name">Expire Treatment Plans</field>
        <field name="model_id" ref="model_treatment_plan_purchase"/>
        <field name="state">code</field>
        <field name="code">model.search([('state','=','active'), ('expiry_date','&lt;', datetime.date.today())]).write({'state':'expired'})</field>
        <field name="interval_number">1</field><field name="interval_type">days</field><field name="active" eval="True"/>
    </record>
</odoo>
