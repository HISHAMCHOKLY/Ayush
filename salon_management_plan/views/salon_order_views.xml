<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_order_form_inherit_plan" model="ir.ui.view">
        <field name="name">salon.order.form.inherit.plan</field>
        <field name="model">salon.order</field>
        <field name="inherit_id" ref="salon_management.salon_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="plan_order_id" readonly="state != 'draft'" domain="[('member_ids', 'in', partner_id), ('state', '=', 'confirm')]"/>
                <field name="plan_member_ids" invisible="1"/>
                <field name="is_care_of" readonly="state != 'draft'" invisible="not plan_order_id"/>
                <field name="care_of_partner_id" readonly="state != 'draft'" invisible="not plan_order_id or not is_care_of" required="is_care_of" domain="[('id', 'in', plan_member_ids)]" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('partner_salon', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
